{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundCloud Downloader",
  "version": "0.1.1",
  "identifier": "com.kushkim.soundclouddownloader",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "SoundCloud Downloader", "width": 1360, "height": 860, "minWidth": 320, "minHeight": 560 }], "security": { "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'" } },
  "bundle": { "active": true, "targets": ["nsis"] }
}
